APP_NAME="Golden West Federal Credit Union"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Every date and time in the app, the daily jobs and the wire cutoff use this zone. Set it once before real data exists:
# changing it later shifts the times already saved.
APP_TIMEZONE=America/New_York

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Set to true once the site is served over HTTPS.
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email through SMTP2GO (https://www.smtp2go.com).
# "log" writes emails to storage/logs instead of sending them (fine for local work).
# To send real email: set MAIL_MAILER=smtp and fill in the SMTP user and password from SMTP2GO
# (Sending > SMTP Users). Ports 2525, 587 and 8025 use STARTTLS; for 465 set MAIL_SCHEME=smtps.
# APP_URL must be your real public address (https://...), or the logo and the links in emails will not work.
MAIL_MAILER=log
MAIL_HOST=mail.smtp2go.com
MAIL_PORT=2525
MAIL_SCHEME=null
MAIL_USERNAME=
MAIL_PASSWORD=
# The From address is the Support email on the Branding page and the From name is its Sender name, so a rebrand
# needs no code change. SMTP2GO only delivers mail from a sender or domain you have verified there
# (Sending > Verified Senders), so verify that support address. To force another address, set MAIL_FROM_ADDRESS.
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional free demo key from coingecko.com. Live crypto prices work without it.
COINGECKO_API_KEY=

# Live crypto prices come from CoinGecko. The free tier works without a key; a demo key raises the limit.
COINGECKO_API_KEY=

# Used only by `php artisan migrate --seed` on a development machine. Never runs in production.
SEED_ADMIN_PASSWORD=
SEED_MEMBER_PASSWORD=

# Admin > System checks this GitHub repository's Releases page for new versions.
# A token is only needed if the repository is private.
# UPDATE_REPO=Growtheworldtogether/goldenwest-fcu
# UPDATE_TOKEN=
